{
  "name": "mateo-cereceda-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "smoke": "node scripts/smoke-routes.mjs",
    "test:anim": "node scripts/tests/anim/run-all.mjs",
    "upload-images": "node scripts/upload-to-cloudinary.cjs",
    "check": "tsc --noEmit",
    "test:equilibrio": "node --test scripts/tests/equilibrio*.test.mjs",
    "equilibrio:godot": "node scripts/equilibrio/export-godot.mjs",
    "format:equilibrio": "prettier --write src/components/games/equilibrio src/routes/index.tsx src/routes/experimental.equilibrio.tsx scripts/tests/equilibrio*.mjs scripts/equilibrio/*.mjs playwright.equilibrio.config.mjs",
    "format:check:equilibrio": "prettier --check src/components/games/equilibrio src/routes/index.tsx src/routes/experimental.equilibrio.tsx scripts/tests/equilibrio*.mjs scripts/equilibrio/*.mjs playwright.equilibrio.config.mjs",
    "equilibrio:sizes": "node scripts/equilibrio/asset-sizes.mjs",
    "test:equilibrio:browser": "playwright test --config playwright.equilibrio.config.mjs",
    "test:equilibrio:landing": "playwright test --config playwright.equilibrio.config.mjs equilibrio-landing.browser.spec.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.130.0",
    "@tanstack/react-start": "^1.130.0",
    "framer-motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cloudinary": "^2.7.0",
    "dotenv": "^17.2.0",
    "lil-gui": "^0.21.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  }
}
