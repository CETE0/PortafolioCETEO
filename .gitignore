# env files (can opt-in for committing if needed)
.env*
!.env.example


# typescript
*.tsbuildinfo

# Reproducible, local-only Godot renderer comparison exports
/public/equilibrio/godot/
/scripts/equilibrio/godot/.godot/
/.equilibrio-build/
